# vLLM Manager 環境変数設定
# このファイルを .env にコピーして編集してください（docker compose が読み込みます）

# === vLLM サーバー設定 ===
VLLM_PORT=8001
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=256
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_TENSOR_PARALLEL_SIZE=1

# === LiteLLM 認証 ===
# 空にすると認証なし（公開モード）
# 値を設定すると Bearer Token 認証が有効になる
LITELLM_MASTER_KEY=sk-vllm-default-key
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=admin
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=litellm
LITELLM_DB_NAME=litellm

# === vLLM Manager 認証 ===
VLLM_MANAGER_ADMIN_USER=admin
VLLM_MANAGER_ADMIN_PASSWORD=admin
# セッション有効期限（秒）。0 で無期限（非推奨）
VLLM_MANAGER_SESSION_TTL_SEC=86400
# ログイン失敗のレート制限
VLLM_MANAGER_LOGIN_MAX_ATTEMPTS=5
VLLM_MANAGER_LOGIN_WINDOW_SEC=300
VLLM_MANAGER_LOGIN_LOCKOUT_SEC=900
# CORS 許可オリジン（カンマ区切り）。空または * で全開放（非推奨）
# VLLM_MANAGER_CORS_ORIGINS=http://hinton.kanazawa-it.ac.jp:13000
# 監査ログのローテーション（1世代あたりの上限バイト数 / 保持世代数）
VLLM_MANAGER_AUDIT_LOG_MAX_BYTES=20971520
VLLM_MANAGER_AUDIT_LOG_BACKUPS=3
# インフラリソース監視（GPU温度・VRAM・ディスク使用率）のしきい値・監視間隔
VLLM_MANAGER_RESOURCE_CHECK_INTERVAL_SEC=30
VLLM_MANAGER_GPU_TEMP_ALERT_C=85
VLLM_MANAGER_GPU_MEMORY_ALERT_PERCENT=95
VLLM_MANAGER_DISK_ALERT_PERCENT=90

# === HuggingFace ===
# モデルダウンロードに必要（大規模モデルの場合）
# HF_TOKEN=your-hf-token
# Xet CDN を無効化（DNS 不安定時は 1 推奨。再有効化する場合は 0）
# HF_HUB_DISABLE_XET=1

# === upstream / ゲートウェイ（大コンテキスト・Hermes 向け）===
# backend → vLLM の read タイムアウト（秒）。litellm-gateway の proxy_read_timeout と揃える。
PROXY_UPSTREAM_READ_TIMEOUT_SEC=600
# LiteLLM 経由の chat/completions で stream=false を stream=true に上書き（0/false で無効）
# 画像付きリクエストでは backend が自動でスキップ（Vision / Hermes の Empty response 対策）
PROXY_FORCE_STREAM=true

# === アプリケーション ===
BACKEND_PORT=18000
FRONTEND_PORT=13000
LITELLM_PORT=14000

# フロントエンドから見える API の公開 URL（必要なら上書き）
# 空にすると frontend(:13000) の同一オリジン経由で backend にプロキシします（推奨）
# 例: NEXT_PUBLIC_API_URL=http://hinton.kanazawa-it.ac.jp:18000
# 例: NEXT_PUBLIC_LITELLM_URL=http://hinton.kanazawa-it.ac.jp:14000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_LITELLM_URL=http://hinton.kanazawa-it.ac.jp:14000
BACKEND_INTERNAL_URL=http://backend:8000

# === Docker ===
DOCKER_COMPOSE_PROJECT_NAME=vllm-manager
# backend イメージに CUDA 12.9+ Toolkit を同梱（Blackwell NVFP4 向け FlashInfer JIT 用）。
# ホスト CUDA で上書きする場合は docker-compose.override.yml でマウント（12.9 未満は不可）:
#   services:
#     backend:
#       volumes:
#         - /path/to/cuda-12.9+:/usr/local/cuda:ro

# === 社内 HTTP プロキシ（通常は不要）===
# ダウンロード失敗時のみ .env に追加してください。
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,::1,backend,litellm,litellm-db,frontend,.local
