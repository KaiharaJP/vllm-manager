# Backend Dockerfile
# FastAPI + vLLM + dependencies
# Blackwell (SM120) NVFP4 向け FlashInfer JIT に CUDA Toolkit 12.9+ が必要

FROM nvidia/cuda:12.9.1-devel-ubuntu22.04

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV DEBIAN_FRONTEND=noninteractive

# プロキシ環境では build 時にも明示的に引き継ぐ
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Blackwell (SM120) 向け nvcc が compute_120f をサポートすることを build 時に検証
RUN nvcc --version \
    && printf '%s\n' '__global__ void k(){}' > /tmp/sm120_test.cu \
    && nvcc -gencode=arch=compute_120f,code=sm_120f -c /tmp/sm120_test.cu -o /tmp/sm120_test.o \
    && rm -f /tmp/sm120_test.cu /tmp/sm120_test.o

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

RUN pip3 install --no-cache-dir vllm

COPY app/ ./app/
COPY config/ ./config/

RUN mkdir -p /app/data

ENV HF_HOME=/root/.cache/huggingface
ENV VLLM_MANAGER_DATA_DIR=/app/data
RUN mkdir -p ${HF_HOME}

EXPOSE 8000 8001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/docs || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
