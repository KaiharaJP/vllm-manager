# Backend Dockerfile
# FastAPI + vLLM + dependencies
# Blackwell (SM120) NVFP4 向け FlashInfer JIT に CUDA Toolkit 12.9+ が必要

FROM nvidia/cuda:12.9.1-devel-ubuntu22.04

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV DEBIAN_FRONTEND=noninteractive

# プロキシ環境では build 時にも明示的に引き継ぐ
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    curl \
    build-essential \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# 非root実行用ユーザー（root 実行はコンテナ侵害時の被害範囲を広げるため回避する）。
# ホストのボリューム（vllm-data / hf-cache）の権限は docker-entrypoint.sh で調整する。
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd -g ${APP_GID} vllmapp \
    && useradd -m -u ${APP_UID} -g ${APP_GID} -s /bin/bash vllmapp

# Blackwell (SM120) 向け nvcc が compute_120f をサポートすることを build 時に検証
RUN nvcc --version \
    && printf '%s\n' '__global__ void k(){}' > /tmp/sm120_test.cu \
    && nvcc -gencode=arch=compute_120f,code=sm_120f -c /tmp/sm120_test.cu -o /tmp/sm120_test.o \
    && rm -f /tmp/sm120_test.cu /tmp/sm120_test.o

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# バージョン未固定だと build のたびに最新 vLLM が入り、挙動が変わる（例: 0.24 で Blackwell FP8 が DeepGEMM で落ちる）。
# 0.27.1 は Qwen3.8（内部的に Qwen3.5 系アーキテクチャ）を使うために採用。
# ただし sm120 (Blackwell) + FP8 ブロックスケールで DeepGEMM が "Unknown SF transformation" で
# 落ちる既知の不具合が 0.27.1 時点でも未解決のため、下記 ENV で DeepGEMM 経路を無効化する
# （https://github.com/vllm-project/vllm/issues/51884 ／ NVFP4 モデルは影響を受けない）。
RUN pip3 install --no-cache-dir "vllm==0.27.1"

# vllm 0.27.1 が引き込む flashinfer-python==0.6.16.post3 は fd_exchange.py に
# `from __future__ import annotations` が無く、Python 3.10 では
# `array.array[int]` のアノテーション評価で起動時に TypeError になる
# （0.6.16.post4 で修正済み）。
RUN pip3 install --no-cache-dir "flashinfer-python==0.6.16.post4"

# 学習ジョブ API（LoRA SFT / DPO / GRPO）用。transformers は vllm が入れた
# バージョンに固定し、resolver による意図しない差し替えを防ぐ。
RUN pip3 install --no-cache-dir "transformers==5.15.0" peft trl datasets accelerate bitsandbytes "kernels>=0.11.1"

# ストレージ内訳 API 用: 非root(vllmapp)でも /hostfs（ro マウント）配下の
# 他ユーザーディレクトリを du で集計できるよう、読み取り権限チェックを
# バイパスする file capability 付きの du コピーを用意する。
# サイズ情報のみ取得可能（ファイル内容は読めない）。/hostfs は read-only
# マウントのため書き込みも不可能なまま。
RUN apt-get update \
    && apt-get install -y --no-install-recommends libcap2-bin \
    && rm -rf /var/lib/apt/lists/* \
    && cp /usr/bin/du /usr/local/bin/du-priv \
    && setcap cap_dac_override+ep /usr/local/bin/du-priv

ENV VLLM_USE_DEEP_GEMM=0
ENV VLLM_MOE_USE_DEEP_GEMM=0

COPY app/ ./app/
COPY config/ ./config/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh /app/scripts/fix-hf-cache-permissions.sh

RUN mkdir -p /app/data

ENV HF_HOME=/app/hf-cache
ENV VLLM_MANAGER_DATA_DIR=/app/data
RUN mkdir -p ${HF_HOME} ${HF_HOME}/.locks ${HF_HOME}/hub/.locks

EXPOSE 8000 8001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/docs || exit 1

# コンテナは root で起動し、entrypoint がボリューム権限を揃えたのち
# 非root ユーザー（vllmapp）へ降格してアプリを実行する。
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
