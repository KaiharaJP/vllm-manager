# vLLM Manager skill — config for vllm-cli.sh / agents
# Copy to .env and edit. CLI auto-loads skills/vllm-manager/.env first.
#
# Ports (same host as the UI at :13000):
#   frontend  :13000
#   backend   :18000  (management API / PAT)
#   LiteLLM   :14000  (inference / sk-)

# === Manager connection ===
VLLM_MANAGER_URL=http://hinton.kanazawa-it.ac.jp:18000
LITELLM_URL=http://hinton.kanazawa-it.ac.jp:14000
FRONTEND_URL=http://hinton.kanazawa-it.ac.jp:13000
BACKEND_PORT=18000
FRONTEND_PORT=13000
LITELLM_PORT=14000

# === Admin login (used by `token create` when flags/env not set) ===
VLLM_MANAGER_ADMIN_USER=admin
VLLM_MANAGER_ADMIN_PASSWORD=admin

# === Inference key (sk-) model allow-list ===
# Used by `inference-key create` when --models is omitted.
#   *  = all models (recommended for first setup / agents)
#   or comma-separated ids, e.g. vllm-local,jinaai/jina-embeddings-v3
VLLM_MANAGER_INFERENCE_MODELS=*
# Optional fixed LiteLLM key_alias for inference-key ensure (default: vllm-cli)
# VLLM_MANAGER_INFERENCE_KEY_ALIAS=vllm-cli

# Optional overrides (normally leave empty; CLI stores keys under ~/.config/vllm-manager/)
# VLLM_MANAGER_TOKEN=
# LITELLM_API_KEY=
# VLLM_MANAGER_SK_KEY=
